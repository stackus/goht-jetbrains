<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.stackus.gohtjetbrains</id>
    <name>GoHT</name>
    <vendor url="https://goht.dev">GoHT</vendor>

    <description>Type-safe HAML, SLIM, and EGO templates for Go.</description>

    <change-notes>
        <p>Initial release with new lexer. No longer depending on a TextMate grammar</p>
        <p>Added "Generate GoHT File(s)" action to context menu</p>
        <p>Added "GoHT LSP" setting pane under Settings -> Tools</p>
    </change-notes>

    <idea-version since-build="251"/>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.ultimate</depends>
    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="GoHT" displayType="BALLOON" isLogByDefault="true"/>
        <applicationService
            serviceImplementation="com.github.stackus.gohtjetbrains.settings.GohtSettings"/>
        <applicationConfigurable
            parentId="tools"
            instance="com.github.stackus.gohtjetbrains.settings.GohtSettingsConfigurable"
            id="com.github.stackus.gohtjetbrains.settings.GohtSettingsConfigurable"
            displayName="GoHT LSP"/>
        <fileType name="goht"
                  language="goht"
                  implementationClass="com.github.stackus.gohtjetbrains.GohtFileType"
                  extensions="goht"
                  fieldName="INSTANCE"/>
        <lang.parserDefinition language="goht"
            implementationClass="com.github.stackus.gohtjetbrains.parser.GohtParserDefinition"/>
        <lang.ast.factory language="goht"
            implementationClass="com.github.stackus.gohtjetbrains.psi.GohtAstFactory"/>
        <lang.syntaxHighlighterFactory language="goht"
            implementationClass="com.github.stackus.gohtjetbrains.highlighter.GohtHighlighterFactory"/>
        <multiHostInjector implementation="com.github.stackus.gohtjetbrains.injection.GohtLanguageInjector"/>
        <daemon.highlightInfoFilter implementation="com.github.stackus.gohtjetbrains.injection.GohtHighlightInfoFilter"/>
        <treeStructureProvider implementation="com.github.stackus.gohtjetbrains.treestructure.GohtTreeStructureProvider"/>
        <platform.lsp.serverSupportProvider implementation="com.github.stackus.gohtjetbrains.lsp.GohtLspServerSupportProvider"/>
        <spellchecker.support language="goht"
            implementationClass="com.intellij.spellchecker.tokenizer.SpellcheckingStrategy"/>
        <spellchecker.bundledDictionaryProvider implementation="com.github.stackus.gohtjetbrains.spellcheck.GohtBundledDictionaryProvider"/>
    </extensions>
    <actions>
        <action
                id="com.github.stackus.gohtjetbrains.actions.GenerateDirAction"
                class="com.github.stackus.gohtjetbrains.actions.GenerateDirAction"
                text="Generate GoHT Files"
                description="Generate Go files from these GoHT templates"
                icon="/icons/goht.svg">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
        <action
            id="com.github.stackus.gohtjetbrains.actions.GenerateFileAction"
            class="com.github.stackus.gohtjetbrains.actions.GenerateFileAction"
            text="Generate GoHT File"
            description="Generate a Go file from this GoHT template"
            icon="/icons/goht.svg">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
